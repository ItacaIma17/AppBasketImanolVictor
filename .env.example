# Copia este archivo a .env y rellena los valores reales
# NUNCA subas .env al repositorio

# PostgreSQL (local con Docker)
POSTGRES_DB=fabaragon_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=TU_PASSWORD_AQUI

# Admin por defecto
ADMIN_SECRET_KEY=TU_CLAVE_ADMIN_AQUI
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=TU_PASSWORD_ADMIN_AQUI
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=Sistema

# JWT
JWT_SECRET=TU_CLAVE_JWT_MINIMO_32_CARACTERES_AQUI
JWT_EXPIRATION=86400000

# Usuarios de prueba
DEFAULT_ENTRENADOR_CODIGO=ENT-100001
DEFAULT_ARBITRO_CODIGO=ARB-100001
DEFAULT_JUGADOR_CODIGO=JUG-100001

# PgAdmin (local)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin123
